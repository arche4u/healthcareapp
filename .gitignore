# OneHealth .gitignore

# Environment
.env
.env.local
.env.*.local

# Dependencies
node_modules/
*/node_modules/
services/*/node_modules/
web/node_modules/

# Build output
dist/
*/dist/
.next/
*/.next/
out/
build/
*/build/

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.venv/
venv/
*.egg-info/
.pytest_cache/
.tox/

# IDE
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store

# Logs
*.log
logs/

# Docker volumes
postgres_data/
redis_data/
minio_data/
.caddy/

# Test coverage
coverage/
.nyc_output/

# Temporary files
tmp/
temp/
*.tmp
*.temp